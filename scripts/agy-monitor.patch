+package cli
+
+import (
+	"bytes"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"testing"
+
+	"github.com/fikrilal/agy-auth/internal/oauth"
+	"github.com/fikrilal/agy-auth/internal/usage"
+)
+
+func TestMonitorAuthorizesAndReadsTwoAccountsWithoutSwitching(t *testing.T) {
+	setTestOAuthClient(t)
+	env := newTestEnv(t, true)
+	live, err := os.ReadFile(env.tokenPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	idTokens := map[string]string{
+		"first-code":  makeCLIIDToken(t, "one@example.test", "monitor-one"),
+		"second-code": makeCLIIDToken(t, "two@example.test", "monitor-two"),
+	}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		code := r.FormValue("code")
+		if idTokens[code] == "" {
+			http.Error(w, "unknown mock code", 400)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_ = json.NewEncoder(w).Encode(map[string]any{
+			"access_token": "test-access-" + code, "expires_in": 3600, "refresh_token": "test-refresh-" + code,
+			"token_type": "Bearer", "id_token": idTokens[code],
+		})
+	}))
+	defer server.Close()
+	oldEndpoint, oldClient := oauth.TokenEndpoint, oauth.HTTPClient
+	oauth.TokenEndpoint, oauth.HTTPClient = server.URL, server.Client()
+	t.Cleanup(func() { oauth.TokenEndpoint, oauth.HTTPClient = oldEndpoint, oldClient })
+
+	var originalRegistrySelection string
+	for i, entry := range []struct{ alias, code string }{{"first", "first-code"}, {"second", "second-code"}} {
+		app, _, errOut := env.app(entry.code + "\n")
+		// The shipped monitor never initializes a live storage or desktop handle.
+		app.Storage, app.Desktop = nil, nil
+		if code := app.RunMonitor([]string{"login", "--monitor-only", "--no-browser", "--alias", entry.alias}); code != 0 {
+			t.Fatalf("monitor login exit = %d: %s", code, errOut)
+		}
+		reg, err := app.Store.Load()
+		if err != nil {
+			t.Fatal(err)
+		}
+		if i == 0 {
+			originalRegistrySelection = reg.Active
+		} else if reg.Active != originalRegistrySelection {
+			t.Fatal("second authorization changed the monitor registry selection")
+		}
+	}
+
+	app, out, errOut := env.app("")
+	app.Storage, app.Desktop = nil, nil
+	provider := &testGroupsProvider{groups: usageGroups()}
+	app.UsageGroups = provider
+	if code := app.RunMonitor([]string{"--json", "usage", "--all"}); code != 0 {
+		t.Fatalf("monitor usage exit = %d: %s", code, errOut)
+	}
+	envelope := decodeTestEnvelope(t, out)
+	var payload struct {
+		Accounts []struct {
+			Email  string        `json:"email"`
+			Groups []usage.Group `json:"groups"`
+		} `json:"accounts"`
+	}
+	if err := json.Unmarshal(envelope.Data, &payload); err != nil {
+		t.Fatal(err)
+	}
+	if len(payload.Accounts) != 2 || provider.callCount() != 2 || len(payload.Accounts[0].Groups) == 0 ||
+		len(payload.Accounts[1].Groups) == 0 || payload.Accounts[0].Email == payload.Accounts[1].Email {
+		t.Fatal("the monitor did not return two independent quota rows")
+	}
+	if after, err := os.ReadFile(env.tokenPath); err != nil || !bytes.Equal(live, after) {
+		t.Fatal("monitor authorization changed the live client credential")
+	}
+}
+
+func TestMonitorRejectsClientManagementCommands(t *testing.T) {
+	env := newTestEnv(t, false)
+	for _, args := range [][]string{{"switch", "first"}, {"login", "--relaunch"}, {"remove", "first"}} {
+		app, _, _ := env.app("")
+		if status := app.RunMonitor(args); status == 0 {
+			t.Fatalf("monitor accepted %v", args)
+		}
+	}
+}
