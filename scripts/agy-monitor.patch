@@ -0,0 +1,18 @@
+// Package quotahelper exposes only the focused monitor entry point.
+package quotahelper
+
+import (
+	"fmt"
+	"os"
+
+	"github.com/fikrilal/agy-auth/internal/cli"
+)
+
+func Run(args []string) int {
+	app, err := cli.NewMonitor()
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "agy-auth-monitor: %v\n", err)
+		return 1
+	}
+	return app.RunMonitor(args)
+}
