new file mode 100644
index 0000000..acc7a11
--- /dev/null
+++ b/internal/cli/monitor.go
@@ -0,0 +1,173 @@
+package cli
+
+import (
+	"fmt"
+	"os"
+	"strings"
+	"time"
+
+	"github.com/fikrilal/agy-auth/internal/agy"
+	"github.com/fikrilal/agy-auth/internal/oauth"
+	"github.com/fikrilal/agy-auth/internal/registry"
+	"github.com/fikrilal/agy-auth/internal/usage"
+	"golang.org/x/term"
+)
+
+// NewMonitor initializes the separate quota store. The live client and the
+// desktop manager deliberately have no role in this command.
+func NewMonitor() (*App, error) {
+	store, err := registry.DefaultStore()
+	if err != nil {
+		return nil, err
+	}
+	return &App{
+		In: os.Stdin, Out: os.Stdout, Err: os.Stderr, Store: store,
+		TTY: term.IsTerminal(int(os.Stdin.Fd())), OutTTY: term.IsTerminal(int(os.Stdout.Fd())),
+		StdinFile: os.Stdin, StdoutFile: os.Stdout, StderrFile: os.Stderr,
+		Now: time.Now, UsageGroups: usage.NewClient(Version),
+	}, nil
+}
+
+const monitorHelp = `agy-auth-monitor: authorize accounts and read quotas for Balance HUD.
+
+Usage:
+  agy-auth-monitor login [--monitor-only] [--alias <name>] [--agy <path>] [--no-browser]
+  agy-auth-monitor login --gcp --project <id> [--region <global|us|eu>]
+  agy-auth-monitor [--json] usage --all
+  agy-auth-monitor [--json] list
+  agy-auth-monitor [--json] version
+
+Authorization only updates the monitor store (AGY_AUTH_HOME).
+`
+
+func (a *App) RunMonitor(args []string) int {
+	args = a.extractGlobals(args)
+	if len(args) == 0 || args[0] == "help" || args[0] == "--help" || args[0] == "-h" ||
+		(len(args) == 2 && (args[1] == "--help" || args[1] == "-h")) {
+		fmt.Fprint(a.Out, monitorHelp)
+		return 0
+	}
+	a.Command = args[0]
+	switch a.Command {
+	case "login":
+		return a.monitorLogin(args[1:])
+	case "usage":
+		if len(args) == 2 && args[1] == "--all" {
+			return a.cmdUsageAll()
+		}
+	case "list", "ls":
+		// The monitor inventory is always local and read-only.
+		for _, arg := range args[1:] {
+			if arg != "--no-sync" && arg != "--no-usage" {
+				return a.failCode("usage", "Run agy-auth-monitor --help.", "unsupported list option %q", arg)
+			}
+		}
+		return a.monitorList()
+	case "version", "--version", "-v":
+		if len(args) == 1 {
+			if a.JSON {
+				_ = a.emitJSON(map[string]string{"version": Version})
+			} else {
+				fmt.Fprintf(a.Out, "agy-auth-monitor %s\n", Version)
+			}
+			return 0
+		}
+	}
+	return a.failCode("usage", "Run agy-auth-monitor --help.", "unsupported command or arguments")
+}
+
+func (a *App) monitorList() int {
+	reg, err := a.Store.Load()
+	if err != nil {
+		return a.monitorStoreFailure(err, "could not read the account registry")
+	}
+	rows := a.pickerRows(reg.Accounts, reg.Active, accountNumbers(reg))
+	if a.JSON {
+		if err := a.emitJSON(map[string]any{"accounts": rows, "current": nil}); err != nil {
+			return a.failCode("output_error", "", "could not write JSON output")
+		}
+		return 0
+	}
+	for _, row := range rows {
+		fmt.Fprintf(a.Out, "%d. %s\n", row.Number, row.displayName())
+	}
+	return 0
+}
+
+func (a *App) monitorStoreFailure(err error, message string) int {
+	return a.failCode("registry_error", "Check the AGY_AUTH_HOME directory and backup permissions.", "%s: %v", message, err)
+}
+
+func (a *App) monitorLogin(args []string) int {
+	fs := a.newFlagSet("login")
+	alias := fs.String("alias", "", "monitor account label")
+	method := fs.String("auth-method", agy.AuthMethodConsumer, "authorization method")
+	gcp := fs.Bool("gcp", false, "Google Cloud project")
+	project := fs.String("project", "", "Google Cloud project ID")
+	region := fs.String("region", "", "Google Cloud region")
+	noBrowser := fs.Bool("no-browser", false, "print the authorization URL")
+	agyPath := fs.String("agy", "", "Antigravity CLI path")
+	fs.Bool("monitor-only", true, "compatibility flag: all authorizations are monitor-only")
+	fail := func(message string) int {
+		return a.failCode("usage", "Run agy-auth-monitor --help.", "%s", message)
+	}
+	if err := fs.Parse(args); err != nil {
+		return fail(err.Error())
+	}
+	if fs.NArg() != 0 {
+		return fail("login takes no positional arguments")
+	}
+	if *alias != "" {
+		if err := registry.ValidateAlias(*alias); err != nil {
+			return fail(err.Error())
+		}
+	}
+	effective := strings.TrimSpace(*method)
+	if effective == "" {
+		effective = agy.AuthMethodConsumer
+	}
+	var projectID, regionValue string
+	if *gcp || strings.TrimSpace(*project) != "" || strings.EqualFold(effective, agy.AuthMethodGCP) {
+		effective = agy.AuthMethodGCP
+		rawProject, rawRegion := strings.TrimSpace(*project), strings.TrimSpace(*region)
+		var err error
+		if rawProject == "" && a.TTY && !a.JSON {
+			rawProject, err = a.readLine("Google Cloud project ID: ")
+			if err != nil {
+				return fail("could not read the Google Cloud project ID")
+			}
+			if rawRegion == "" && strings.TrimSpace(rawProject) != "" {
+				rawRegion, err = a.readLine("Google Cloud region [global/us/eu] (default: global): ")
+				if err != nil {
+					return fail("could not read the Google Cloud region")
+				}
+			}
+		}
+		projectID, err = agy.ValidateProjectID(rawProject)
+		if err != nil {
+			return fail(err.Error())
+		}
+		regionValue, err = agy.ValidateRegion(rawRegion)
+		if err != nil {
+			return fail(err.Error())
+		}
+	} else if strings.TrimSpace(*region) != "" {
+		return fail("--region requires --gcp or --project")
+	}
+	if err := oauth.EnsureClientForMethod(*agyPath, effective); err != nil {
+		return a.failCode("oauth_error", "Pass --agy <path> or set AGY_AUTH_AGY_PATH.", "could not discover the Antigravity OAuth client")
+	}
+	raw, warnings, code := a.requestOAuth(effective, projectID, regionValue, *noBrowser)
+	if code != 0 {
+		return code
+	}
+	result, err := a.Store.Upsert(raw, *alias, false)
+	if err != nil {
+		return a.monitorStoreFailure(err, "could not save the monitoring account")
+	}
+	for _, warning := range warnings {
+		a.warn("%s", warning)
+	}
+	fmt.Fprintf(a.Out, "Monitoring account saved: %s\n", result.Account.DisplayName())
+	return 0
+}
